# Copy to ~/.consilium/.env — or export in your shell (shell always wins).
# Consilium runs with NO keys at all: quant analysts + rules-based Red Team/CIO
# on yfinance (free) or the offline synthetic market. Keys only add the LLM personas.

# One of these staffs the LLM personas and the LLM chair:
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
XAI_API_KEY=
GROQ_API_KEY=

# One key, every vendor — and what the multi-model board is built for:
OPENROUTER_API_KEY=

# Local & free: run `ollama serve`, then `consilium backtest ... --model ollama:llama3.1`

# Default model for the personas (any registry id or provider:model)
# CONSILIUM_MODEL=claude-sonnet-5

# Force the keyless path even if keys exist (useful for deterministic tests)
# CONSILIUM_NO_LLM=1

# Where mandates, the ledger, caches and run receipts live (default ~/.consilium)
# CONSILIUM_HOME=
